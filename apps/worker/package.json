{
  "name": "@multi-ai-coder/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @multi-ai-coder/shared build && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests src"
  },
  "dependencies": {
    "@multi-ai-coder/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.65.0",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  }
}
