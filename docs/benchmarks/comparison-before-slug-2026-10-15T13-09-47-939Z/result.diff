+export const slugify = (text) => {
+  if (text === '') return '';
+  const lower = text.toLowerCase().trim();
+  const slug = lower.replace(/[^a-z0-9]+/g, '-');
+  return slug.replace(/^-+|-+$/g, '');
+};
