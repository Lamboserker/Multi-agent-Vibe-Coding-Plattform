+export const slugify = (text) => {
+  if (text == null) return '';
+  const trimmed = text.trim();
+  const lower = trimmed.toLowerCase();
+  return lower.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+};
